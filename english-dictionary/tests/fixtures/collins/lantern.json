  "entryContent": "<div class=\"entry_container\">\n<div class=\"entry lang_en-gb\" id=\"lantern_3\">\n<div class=\"formTypeInfl\">\n<span class=\"orth\">lanterns\n<span class=\"pron\">ˈlæntənz\n<a class=\"playback\" href=\"#\"><img class=\"sound\" src=\"/external/images/soundS.png\" alt=\"\"></a>\n<audio><source src=\"https://api.collinsdictionary.com/media/sounds/fixture/lanterns_gb_01.mp3\" type=\"audio/mpeg\">Your browser does not support the audio element.</audio>\n</span>\n</span>\n</div>\n<div class=\"hwd_sound\">\n<h1 class=\"hwd\">lantern</h1>\n<span class=\"lbfreq\">●●○</span>\n<span class=\"pron\">ˈlæntən\n<a class=\"playback\" href=\"#\" title=\"Pronunciation for lantern\"><img class=\"sound\" src=\"/external/images/soundS.png\" alt=\"\"></a>\n<audio><source src=\"https://api.collinsdictionary.com/media/sounds/fixture/lantern_gb_01.mp3\" type=\"audio/mpeg\">Your browser does not support the audio element.</audio>\n</span>\n</div>\n<div class=\"hom\">\n<span class=\"sensenum\">1 </span>\n<span class=\"gramGrp\"><span class=\"pos\">countable noun</span></span>\n<span class=\"gramGrp\"><span class=\"lbl\">[usu ADJ n]</span></span>\n<div class=\"sense\">\n<span class=\"def\">A <em class=\"hi\">lantern</em> is a small hooded lamp that a walker carries to light a narrow path at night.</span>\n<span class=\"cit type-example\"><span class=\"quote\">She hung the lantern on the gatepost and waited for the rain to stop.</span></span>\n</div>\n</div>\n<div class=\"hom\">\n<span class=\"sensenum\">2 </span>\n<span class=\"gramGrp\"><span class=\"pos\">countable noun</span></span>\n<div class=\"sense\">\n<span class=\"def\">A <em class=\"hi\">lantern</em> is the glazed upper stage of a tower that drops daylight into the hall below.</span>\n</div>\n<span class=\"cit type-example\"><span class=\"lbl\">[+ of]</span><span class=\"quote\">The lantern of the old market hall was rebuilt from the ledger drawings.</span></span>\n</div>\n<div class=\"hom\">\n<span class=\"sensenum\">3 </span>\n<span class=\"gramGrp\"><span class=\"pos\">verb</span></span>\n<span class=\"gramGrp\"><span class=\"lbl\">[VERB noun]</span></span>\n<div class=\"sense\">\n<span class=\"def\">If you <em class=\"hi\">lantern</em> a path, you set lamps along it so that walkers can follow it after dark.</span>\n<span class=\"cit type-example\"><span class=\"quote\">They lanterned the towpath before the winter parcel run began.</span></span>\n</div>\n<span class=\"re\">\n<span class=\"orth\">lanterned</span>\n<span class=\"gramGrp\"><span class=\"pos\">adjective</span></span>\n<span class=\"pron\">ˈlæntənd\n<a class=\"playback\" href=\"#\"><img class=\"sound\" src=\"/external/images/soundS.png\" alt=\"\"></a>\n<audio><source src=\"https://api.collinsdictionary.com/media/sounds/fixture/lanterned_gb_01.mp3\" type=\"audio/mpeg\">Your browser does not support the audio element.</audio>\n</span>\n<span class=\"cit type-example\"><span class=\"quote\">A lanterned trellis marked the turn to the lower garden.</span></span>\n</span>\n</div>\n<div class=\"hom\">\n<div class=\"sense\">\n<span class=\"xr\">→ see also <span class=\"ref\">storm lantern</span></span>\n</div>\n</div>\n</div>\n</div>",
