---
import '../styles/base.css';
import interWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

/* One Latin file of Inter Variable, preloaded; declared here so the preload and the face share the same hashed URL. */
const latin =
  'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const face = (family: string, url: string, weights: string) =>
  `@font-face{font-family:"${family}";font-style:normal;font-display:swap;font-weight:${weights};src:url(${url}) format("woff2-variations");unicode-range:${latin}}`;
const fontFaces = face('Inter Variable', interWoff2, '100 900');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <!-- Layer order is fixed by first appearance, so it is declared before any stylesheet. -->
    <style is:inline>@layer reset, tokens, components;</style>
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Named icon.svg, not favicon.svg, and versioned in the query, because browsers cache a favicon by URL and keep an older mark otherwise. -->
    <link rel="icon" href={`${import.meta.env.BASE_URL}/icon.svg?v=2`} type="image/svg+xml" />
    <link rel="preload" href={interWoff2} as="font" type="font/woff2" crossorigin />
    <style set:html={fontFaces}></style>
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/reveal';
    </script>
  </body>
</html>
