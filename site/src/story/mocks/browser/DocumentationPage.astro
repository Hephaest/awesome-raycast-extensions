---
import Icon from '../Icon.astro';
import KeelsonMark from './KeelsonMark.astro';
import { documentation } from '../../story';

/**
 * Keelson's guide in the mint docs layout: a top bar with search, a tab row, a narrow sidebar, the article and an
 * "On this page" list. The sidebar stays narrow so the selected word, which opens the paragraph, clears the dictionary.
 */
const [beforeWord, afterWord] = documentation.sentence.split(documentation.selection);
---

<div class="docs-page">
  <header class="docs-page__bar">
    <span class="docs-page__brand"><KeelsonMark size={18} /><strong>{documentation.vendor}</strong><span>Docs</span></span>
    <span class="docs-page__search"><Icon name="search" size={13} />Search...<kbd>⌘K</kbd></span>
    <span class="docs-page__dashboard">Dashboard</span>
  </header>
  <nav class="docs-page__tabs"><span class="docs-page__tab--current">Guides</span><span>API reference</span><span>SDKs</span></nav>
  <div class="docs-page__layout">
    <aside class="docs-page__sidebar">
      <strong>Get started</strong>
      <span>Overview</span><span>API keys</span>
      <strong>Reliability</strong>
      <span>Rate limits</span><span class="docs-page__current">Retries</span><span>Errors</span><span>Webhooks</span>
    </aside>
    <article class="docs-page__article">
      <p class="docs-page__eyebrow">Reliability</p>
      <div class="docs-page__title">
        <h1>{documentation.title}</h1>
        <span class="docs-page__copy"><svg width="12" height="12" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5" /></svg>Copy page</span>
      </div>
      <p class="docs-page__lead">Decide which failures to retry, wait between attempts, and never apply an operation twice.</p>
      <h2>When to retry</h2>
      <p>{beforeWord}<mark data-selection>{documentation.selection}</mark>{afterWord}</p>
      <p>Retry 429 and 5xx responses after a delay that doubles each time. Stop after three attempts and report the error.</p>
      <figure class="docs-page__code">
        <figcaption><span class="docs-page__tab--current">Node.js</span><span>Python</span><span>cURL</span><svg class="docs-page__code-copy" width="13" height="13" viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" /><path d="M10.5 3.5v-.5a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5" /></svg></figcaption>
        <pre><code><b>await</b> keelson.arrivals.create(params, {'{'}<br />  idempotencyKey: <i>'arr_7Qd2'</i>,<br />  maxRetries: <i>3</i>,<br />{'}'});</code></pre>
      </figure>
    </article>
    <aside class="docs-page__toc">
      <strong>On this page</strong>
      <span class="docs-page__current">When to retry</span><span>Idempotency keys</span><span>Unknown outcomes</span>
    </aside>
  </div>
</div>

<style>
  @layer components {
    .docs-page {
      display: grid;
      grid-template-rows: 48px 36px minmax(0, 1fr);
      min-block-size: 100%;
      background: var(--docs-bg);
      color: var(--docs-ink-2);
      font: 14px/24px var(--font-ui);
    }

    .docs-page__bar {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding-inline: 16px;
    }

    .docs-page__brand {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 14px;
      color: var(--docs-ink-3);
    }

    .docs-page__brand strong {
      font-weight: 600;
      color: var(--docs-ink);
    }

    .docs-page__search {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      inline-size: 220px;
      block-size: 30px;
      padding-inline: 12px 6px;
      border-radius: 15px;
      background: var(--docs-fill);
      font-size: 13px;
      color: var(--docs-ink-3);
    }

    .docs-page__search kbd {
      margin-inline-start: auto;
      padding: 1px 6px;
      border-radius: 6px;
      box-shadow: inset 0 0 0 1px var(--docs-line);
      font: 500 11px/16px var(--font-ui);
    }

    .docs-page__dashboard {
      justify-self: end;
      padding: 4px 12px;
      border-radius: 15px;
      background: var(--docs-button);
      color: var(--docs-on-button);
      font-size: 12px;
      font-weight: 500;
      line-height: 20px;
    }

    .docs-page__tabs {
      display: flex;
      gap: 22px;
      padding-inline: 16px;
      border-block-end: 1px solid var(--docs-line);
      font-size: 13px;
      font-weight: 500;
      line-height: 35px;
      color: var(--docs-ink-3);
    }

    .docs-page__tabs .docs-page__tab--current {
      color: var(--docs-ink);
      box-shadow: inset 0 -1.5px 0 var(--docs-brand);
    }

    .docs-page__layout {
      display: grid;
      grid-template-columns: 96px minmax(0, 1fr) 128px;
      min-block-size: 0;
      overflow: clip;
    }

    .docs-page__sidebar,
    .docs-page__toc {
      display: grid;
      align-content: start;
      font-size: 12px;
      line-height: 16px;
    }

    .docs-page__sidebar {
      padding: 20px 0 0 16px;
      row-gap: 10px;
    }

    .docs-page__sidebar strong,
    .docs-page__toc strong {
      font-size: 11px;
      font-weight: 600;
      color: var(--docs-ink);
    }

    .docs-page__sidebar strong:not(:first-child) {
      margin-block-start: 10px;
    }

    .docs-page__toc {
      padding: 24px 16px 0 0;
      row-gap: 9px;
    }

    .docs-page .docs-page__current {
      font-weight: 500;
      color: var(--docs-brand);
    }

    .docs-page__article {
      padding: 22px 16px 0;
    }

    .docs-page__eyebrow {
      font-size: 12px;
      font-weight: 500;
      line-height: 16px;
      color: var(--docs-brand);
    }

    .docs-page__title {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-block: 6px 6px;
    }

    .docs-page h1 {
      font-size: 26px;
      font-weight: 500;
      line-height: 32px;
      letter-spacing: -0.4px;
      color: var(--docs-ink);
    }

    .docs-page__copy {
      display: inline-flex;
      flex: none;
      align-items: center;
      gap: 6px;
      padding: 3px 9px;
      border-radius: 10px;
      box-shadow: inset 0 0 0 1px var(--docs-line);
      font-size: 12px;
      font-weight: 500;
      line-height: 18px;
      color: var(--docs-ink-2);
    }

    .docs-page svg:not(.keelson-mark, .icon) {
      fill: none;
      stroke: currentColor;
      stroke-width: 1.4;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .docs-page__lead {
      color: var(--docs-ink-3);
    }

    .docs-page h2 {
      margin-block: 20px 6px;
      font-size: 17px;
      font-weight: 600;
      line-height: 24px;
      color: var(--docs-ink);
    }

    .docs-page p + p {
      margin-block-start: 10px;
    }

    .docs-page mark {
      color: inherit;
    }

    .docs-page__code {
      margin: 14px 0 0;
      border-radius: 12px;
      box-shadow: inset 0 0 0 1px var(--docs-line);
      overflow: clip;
    }

    .docs-page__code figcaption {
      display: flex;
      align-items: center;
      gap: 16px;
      padding-inline: 14px 12px;
      border-block-end: 1px solid var(--docs-line);
      font-size: 12px;
      font-weight: 500;
      line-height: 33px;
      color: var(--docs-ink-3);
    }

    .docs-page__code .docs-page__tab--current {
      color: var(--docs-ink);
      box-shadow: inset 0 -1.5px 0 var(--docs-brand);
    }

    .docs-page__code-copy {
      margin-inline-start: auto;
    }

    .docs-page pre {
      margin: 0;
      padding: 10px 14px 12px;
      font: 12px/20px var(--font-mono);
      color: var(--docs-ink);
    }

    .docs-page pre b {
      font-weight: 400;
      color: var(--primer-purple);
    }

    .docs-page pre i {
      font-style: normal;
      color: var(--docs-brand);
    }
  }
</style>
