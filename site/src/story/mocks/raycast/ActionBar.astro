---
import { Image } from 'astro:assets';
import Keycap from './Keycap.astro';
import Icon from '../Icon.astro';
import { extensionByFolder } from '../../../data/extensions';

/**
 * Raycast 2.9's footer: no bar, two floating pills over the window's bottom edge.
 * The left pill names the command, or is the round menu button on root search; the right pill holds the primary
 * action and Actions with their keycaps. Measured from captures: 36px pills, 8px from the window's edges, 13px text.
 */
interface Props {
  /** The extension whose icon and command name sit on the left; a Raycast command of its own shows a folder glyph. */
  extension?: 'jira' | 'github' | 'zadig' | 'english-dictionary';
  command?: string;
  /** Root search shows the round menu button instead of a command. */
  root?: boolean;
  /** The primary action on the right, with its Return keycap. */
  action: string;
}

const { extension, command = '', root = false, action } = Astro.props;
const icon = extension ? extensionByFolder(extension).icon : undefined;
---

<div class="rc-actionbar">
  {
    root ? (
      <span class="rc-actionbar__pill rc-actionbar__menu">
        <Icon name="menu" size={16} />
      </span>
    ) : (
      <span class="rc-actionbar__pill rc-actionbar__command">
        {icon ? <Image src={icon} alt="" width={36} height={36} class="rc-actionbar__icon" /> : <Icon name="folder" size={18} class="rc-actionbar__icon" />}
        <span>{command}</span>
      </span>
    )
  }
  <span class="rc-actionbar__pill rc-actionbar__actions">
    <span class="rc-actionbar__primary">
      <span>{action}</span>
      <Keycap keys="↵" />
    </span>
    <span class="rc-actionbar__more">
      <span>Actions</span>
      <span class="rc-actionbar__keys"><Keycap keys="⌘" /><Keycap keys="K" /></span>
    </span>
  </span>
</div>

<style is:global>
  @layer components {
    .rc-actionbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      block-size: 52px;
      padding: 8px;
      font-size: 13px;
    }

    .rc-actionbar__pill {
      display: inline-flex;
      align-items: center;
      block-size: 36px;
      border-radius: 18px;
      background: var(--rc-pill);
      /* The measured pill: a white edge all round and a soft shadow under it, so it lifts off the glass. */
      box-shadow:
        inset 0 0 0 1px var(--rc-window-rim),
        0 2px 6px var(--rc-pill-edge);
      white-space: nowrap;
    }

    .rc-actionbar__command {
      gap: 9px;
      padding-inline: 10px 15px;
      color: var(--app-ink-2);
    }

    .rc-actionbar__menu {
      justify-content: center;
      inline-size: 36px;
      color: var(--app-ink-2);
    }

    .rc-actionbar__icon {
      inline-size: 18px;
      block-size: 18px;
      border-radius: 4px;
    }

    .rc-actionbar__actions {
      gap: 16px;
      padding-inline: 15px 10px;
    }

    .rc-actionbar__primary,
    .rc-actionbar__more {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .rc-actionbar__primary {
      font-weight: 500;
    }

    .rc-actionbar__more {
      color: var(--app-ink-2);
    }

    .rc-actionbar__keys {
      display: inline-flex;
      gap: 4px;
    }
  }
</style>
