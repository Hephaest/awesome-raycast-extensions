---
/**
 * The mock Raycast window: 750 by 475 at full size, as Raycast 2.9 draws it, scaled by its scene container.
 * Compose it from SearchBar, a body, and ActionBar. Everything inside is decorative and aria-hidden by the scene.
 * Sizes inside the window are Raycast's, measured from captures: 14px text, 38px rows, a 26px corner.
 */
interface Props {
  class?: string;
  reflow?: boolean;
  /** A name the stage script can find the window by. */
  id?: string;
}

const { class: className, id, reflow = false } = Astro.props;
---

<div class:list={['rc-window', reflow && 'rc-window--reflow', className]} data-window={id}>
  <slot name="search" />
  <div class="rc-window__body">
    <slot />
  </div>
  <slot name="footer" />
  <slot name="overlay" />
</div>

<style is:global>
  @layer components {
    /* Inside a window the inks are Raycast's own; the browser, GitHub and macOS mocks around it keep theirs. */
    .rc-window {
      --rc-row: 38px;
      --app-selection: var(--rc-selection);
      --app-ink: var(--rc-ink);
      --app-ink-2: var(--rc-ink-2);
      --app-ink-3: var(--rc-ink-3);
      --app-ink-4: var(--rc-ink-4);
      position: absolute;
      inset-inline-start: 20px;
      inset-block-start: 20px;
      display: grid;
      grid-template-rows: auto 1fr auto;
      inline-size: 750px;
      block-size: 475px;
      border-radius: 26px;
      /*
       * A stable surface keeps the window legible while its canvas reveals. The grey gradient, the bright top rim and
       * the fine edge stand in for the glass, which takes its tone from whatever sits behind it.
       */
      background: var(--rc-window);
      box-shadow:
        inset 0 1px 0 var(--rc-window-rim),
        0 0 0 0.5px rgb(0 0 0 / 0.22),
        0 28px 70px -18px rgb(0 0 0 / 0.38),
        0 8px 20px -8px rgb(0 0 0 / 0.16);
      color: var(--app-ink);
      font-family: var(--font-ui);
      font-size: 14px;
      line-height: 1.3;
      overflow: clip;
      transform-origin: 50% 60%;
    }

    .rc-window__body {
      position: relative;
      min-block-size: 0;
      overflow: clip;
    }

    /* Only single-column content reflows; split windows keep their design size inside WindowFit. */
    @media (width < 1150px), (height < 700px) {
      .rc-window--reflow {
        position: relative;
        inset: auto;
        inline-size: 100%;
        block-size: auto;
        min-block-size: 240px;
      }

      .rc-window--reflow .rc-actionbar { flex-wrap: wrap; block-size: auto; min-block-size: 52px; }
      .rc-window--reflow .rc-actionbar__actions { margin-inline-start: auto; }
      .rc-window--reflow .rc-row { flex-wrap: wrap; block-size: auto; min-block-size: 40px; padding-block: 8px; white-space: normal; }
      .rc-window--reflow .rc-row__title { flex: 1; overflow: visible; }
      .rc-window--reflow .rc-row__subtitle { overflow: visible; }
      .rc-window--reflow .rc-row__accessories { flex-wrap: wrap; max-inline-size: 100%; }
      .rc-window--reflow .rc-search { flex-wrap: wrap; block-size: auto; min-block-size: 64px; padding-block: 10px; }
      .rc-window--reflow .rc-search__field { min-inline-size: 120px; white-space: normal; }
    }
  }
</style>
