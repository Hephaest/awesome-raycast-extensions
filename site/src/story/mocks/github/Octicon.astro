---
/**
 * GitHub's 16px UI glyphs, redrawn for this page in Octicons' 1.5px line weight: never the GitHub mark.
 * The glyph strokes in currentColor, so a parent sets its color.
 */
const glyphs = {
  'three-bars': '<path d="M2 3.75h12M2 8h12M2 12.25h12"/>',
  search: '<circle cx="7" cy="7" r="4.75"/><path d="m10.5 10.5 3.75 3.75"/>',
  copilot:
    '<path d="M3 4.75C3 3.5 3.9 2.5 5.25 2.5S7.5 3.5 7.5 4.75 6.6 6.75 5.25 6.75 3 6 3 4.75zM8.5 4.75c0-1.25.9-2.25 2.25-2.25S13 3.5 13 4.75s-.9 2-2.25 2-2.25-.75-2.25-2z"/><path d="M2.25 7.5v3.25c0 1.6 2.6 2.75 5.75 2.75s5.75-1.15 5.75-2.75V7.5"/><path d="M6.25 9.25v1.5M9.75 9.25v1.5"/>',
  plus: '<path d="M8 2.75v10.5M2.75 8h10.5"/>',
  'triangle-down': '<path d="M4.75 6.5h6.5L8 9.75z" fill="currentColor"/>',
  inbox:
    '<path d="M3.6 2.75h8.8l1.85 6v3.5a1 1 0 0 1-1 1H2.75a1 1 0 0 1-1-1v-3.5z"/><path d="M1.75 8.75h3.5l.75 1.75h4l.75-1.75h3.5"/>',
  'issue-opened': '<circle cx="8" cy="8" r="6.25"/><circle cx="8" cy="8" r="1" fill="currentColor"/>',
  'git-pull-request':
    '<circle cx="4" cy="3.5" r="1.75"/><circle cx="4" cy="12.5" r="1.75"/><circle cx="12" cy="12.5" r="1.75"/><path d="M4 5.25v5.5M12 10.75V6.5a2 2 0 0 0-2-2H7.25M9 2.75 7.25 4.5 9 6.25"/>',
  code: '<path d="M5.25 4.25 1.5 8l3.75 3.75M10.75 4.25 14.5 8l-3.75 3.75"/>',
  play: '<circle cx="8" cy="8" r="6.25"/><path d="M6.5 5.4v5.2L10.6 8z"/>',
  table: '<rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"/><path d="M1.75 6h12.5M6.25 6v7.75"/>',
  'comment-discussion':
    '<path d="M1.75 2.75a1 1 0 0 1 1-1h6.5a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1H5.5L3.25 10.5V8.25h-.5a1 1 0 0 1-1-1z"/><path d="M12.75 5.25h.5a1 1 0 0 1 1 1v4.5a1 1 0 0 1-1 1h-.5V14l-2.25-2.25H7.75a1 1 0 0 1-1-1V10"/>',
  'git-commit': '<circle cx="8" cy="8" r="2.75"/><path d="M1 8h4.25M10.75 8H15"/>',
  checklist:
    '<path d="M8.5 14.25H3.25a1 1 0 0 1-1-1V2.75a1 1 0 0 1 1-1h8.5a1 1 0 0 1 1 1V8.5"/><path d="M5 5h5M5 8h3M9.5 12.25l1.5 1.5 3-3"/>',
  'file-diff':
    '<path d="M3.75 1.75h5.5l3.5 3.5v8a1 1 0 0 1-1 1h-8a1 1 0 0 1-1-1v-10.5a1 1 0 0 1 1-1z"/><path d="M8 5v4M6 7h4M6 11.25h4"/>',
  copy: '<path d="M5.25 5.25V2.75a1 1 0 0 1 1-1h7a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-2.5"/><rect x="1.75" y="5.25" width="9" height="9" rx="1"/>',
  'chevron-down': '<path d="m4 6 4 4 4-4"/>',
  'sidebar-expand':
    '<rect x="1.75" y="2.25" width="12.5" height="11.5" rx="1.5"/><path d="M6 2.25v11.5M8.75 6.25 10.5 8l-1.75 1.75"/>',
  check: '<path d="m2.75 8.5 3.5 3.5 7-7.5"/>',
  x: '<path d="m3.75 3.75 8.5 8.5M12.25 3.75l-8.5 8.5"/>',
  eye: '<path d="M1.5 8S4 3.25 8 3.25 14.5 8 14.5 8 12 12.75 8 12.75 1.5 8 1.5 8z"/><circle cx="8" cy="8" r="2"/>',
  'kebab-horizontal':
    '<circle cx="3" cy="8" r="1.25" fill="currentColor" stroke="none"/><circle cx="8" cy="8" r="1.25" fill="currentColor" stroke="none"/><circle cx="13" cy="8" r="1.25" fill="currentColor" stroke="none"/>',
  'fold-up': '<path d="M8 9.5V3M5.5 5.5 8 3l2.5 2.5M2 12.75h1.5M5.5 12.75H7M9 12.75h1.5M12.5 12.75H14"/>',
  'git-merge':
    '<circle cx="4.5" cy="3.25" r="1.75"/><circle cx="4.5" cy="12.75" r="1.75"/><circle cx="11.5" cy="8" r="1.75"/><path d="M4.5 5v6M4.5 5c0 2.25 2.25 3 5.25 3"/>',
  square: '<rect x="2.25" y="2.25" width="11.5" height="11.5" rx="2"/>',
  'square-checked': '<rect x="2.25" y="2.25" width="11.5" height="11.5" rx="2" fill="var(--primer-blue)" stroke="var(--primer-blue)"/><path d="m5.25 8.1 1.9 1.9 3.6-3.9" stroke="#fff"/>',
  organization:
    '<path d="M1.75 14.25h12.5M3 14.25V2.75a1 1 0 0 1 1-1h5a1 1 0 0 1 1 1v11.5M10 6.75h2.5a1 1 0 0 1 1 1v6.5M5.25 4.5h2.5M5.25 7.25h2.5M5.25 10h2.5"/>',
  bell: '<path d="M4 6.5a4 4 0 0 1 8 0v3l1.5 2.5h-11L4 9.5z"/><path d="M6.5 14h3"/>',
  'dot-fill': '<circle cx="8" cy="8" r="3.5" fill="currentColor" stroke="none"/>',
};

export type OcticonName = keyof typeof glyphs;

interface Props {
  name: OcticonName;
  size?: number;
  class?: string;
}

const { name, size = 16, class: className } = Astro.props;
---

<svg class:list={['octicon', className]} width={size} height={size} viewBox="0 0 16 16" aria-hidden="true" set:html={glyphs[name]} />

<style is:global>
  @layer components {
    .octicon {
      flex: none;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      overflow: visible;
    }
  }
</style>
