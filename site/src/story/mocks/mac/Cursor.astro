---
/**
 * A macOS pointer, placed at its stage's origin. Scripts move it with `moveCursor()`.
 * The arrow's hotspot is its tip at (2, 1.5); the text I-beam's is its center at (4.5, 9).
 */
interface Props {
  id?: string;
  /** The arrow, or the text I-beam that shows over selectable text. */
  shape?: 'arrow' | 'text';
}

const { id, shape = 'arrow' } = Astro.props;
---

{
  shape === 'arrow' ? (
    <svg class="mac-cursor" data-cursor={id} width="18" height="22" viewBox="0 0 18 22" aria-hidden="true">
      <path d="M2 1.5v16.2l4.1-3.6 2.7 5.8 2.9-1.3-2.7-5.7h5.3z" />
    </svg>
  ) : (
    <svg class="mac-cursor mac-cursor--text" data-cursor={id} width="9" height="18" viewBox="0 0 9 18" aria-hidden="true">
      <path d="M1 1.5c2 0 3.5.6 3.5 2v11c0 1.4-1.5 2-3.5 2M8 1.5c-2 0-3.5.6-3.5 2v11c0 1.4 1.5 2 3.5 2M2.5 9h4" />
    </svg>
  )
}

<style is:global>
  @layer components {
    /* macOS draws its pointers black with a white outline in both appearances, so these two colors never follow a theme. */
    .mac-cursor {
      --cursor-fill: #000;
      --cursor-outline: #fff;
      position: absolute;
      inset-inline-start: 0;
      inset-block-start: 0;
      opacity: 0;
      z-index: 10;
      filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.35));
      will-change: translate;
      pointer-events: none;

      & path {
        fill: var(--cursor-fill);
        stroke: var(--cursor-outline);
        stroke-width: 1.2;
        stroke-linejoin: round;
      }
    }

    .mac-cursor--text {
      filter: drop-shadow(0 0 1px var(--cursor-outline));

      & path {
        fill: none;
        stroke: var(--cursor-fill);
        stroke-width: 1.3;
        stroke-linecap: round;
      }
    }
  }
</style>
