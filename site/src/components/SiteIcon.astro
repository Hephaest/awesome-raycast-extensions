---
/**
 * The site's mark: a rounded puzzle piece, a tab on top and a socket cut into its right side, in the current colour.
 * The favicon (public/icon.svg) is the same path alone, dark on a light tab bar and light on a dark one.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg class:list={['site-icon', className]} width={size} height={size} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <path fill="currentColor" d="M5 7h3V5a3 3 0 0 1 6 0v2h5a2 2 0 0 1 2 2v3h-2a3 3 0 0 0 0 6h2v2a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z" />
</svg>

<style is:global>
  @layer components {
    .site-icon {
      flex: none;
    }
  }
</style>
